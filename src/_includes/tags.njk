<h2>Tags:</h2>
<div class="tag-list">
  {% for tag in collections | getAllTags %}
    {% if tag != "posts" %}
      <a href="/posts/tags/{{ tag }}/" class="tag">#{{ tag }}</a>
    {% endif %}
  {% endfor %}
</div>
